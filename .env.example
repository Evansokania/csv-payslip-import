# Copy to .env and fill in. Do not commit .env with secrets.

MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=your_tenant_db

APP_TITLE=CSV Payslip Import
HOST=127.0.0.1
PORT=8890

# Optional: Azure OpenAI for intelligent column mapping (earning vs deduction vs computed)
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=https://your-resource.cognitiveservices.azure.com
AZURE_OPENAI_API_VERSION=2025-01-01-preview
AZURE_OPENAI_DEPLOYMENT_NAME=gpt-4o
